// use prisma-8

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())

  appliances    Appliance[]
  tariffs       Tariff[]
  outages       PowerOutage[]
  energySources EnergySource[]
}

model Appliance {
  id          Int      @id @default(autoincrement())
  name        String
  powerWatts  Int
  hoursPerDay Float
  isFlexible  Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Tariff {
  id          Int      @id @default(autoincrement())
  name        String
  pricePerKwh Float
  startHour   Int?
  endHour     Int?
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model PowerOutage {
  id        Int      @id @default(autoincrement())
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model EnergySource {
  id         Int      @id @default(autoincrement())
  name       String
  powerWatts Int
  capacityWh Int?
  createdAt  DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id])
}